{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/OmenHubLighterPlus/OmenHubLighterPlus.csproj",
                "--configuration",
                "Debug",
                "/property:Platform=x64",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/OmenHubLighterPlus/OmenHubLighterPlus.csproj",
                "--configuration",
                "Release",
                "/property:Platform=x64",
                "-r",
                "win-x64",
                "--self-contained",
                "false"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "restore",
            "command": "dotnet",
            "type": "process",
            "args": [
                "restore",
                "${workspaceFolder}/OmenHubLight.sln"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
