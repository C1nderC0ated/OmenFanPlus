<Project Sdk="Microsoft.NET.Sdk">

  <!-- HP BIOS WMI access (thermal modes, fan levels, OMEN key events). The namespaces follow HP's own
       assemblies, which this code was reverse-engineered from; see THIRD-PARTY-NOTICES.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Hp</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>

</Project>
