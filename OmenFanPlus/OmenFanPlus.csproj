<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<PlatformTarget>x64</PlatformTarget>
		<!-- Needed by LibreHardwareMonitorLib, which only ships runtime-specific assemblies. -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<!-- The one place the version lives: a release tag must be "v" + this (the release workflow checks). -->
		<Version>2.2.0</Version>
		<Product>OmenFanPlus</Product>
		<!-- Keep the version shown in the app as "2.0.0" rather than "2.0.0+<commit>". -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<!-- The UI is English only; this drops the TaskScheduler package's 11 language folders from the install. -->
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
	  <InternalsVisibleTo Include="OmenFanPlus.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <!-- Microsoft.Extensions.Options removed: nothing in the solution uses it. -->
	  <PackageReference Include="TaskScheduler" Version="2.12.2" />
	  <!-- ExcludeAssets replaces the hard-coded C:\Users\joery\.nuget\... <Content Remove> for the package logo. -->
	  <PackageReference Include="WindowsInput" Version="6.4.1" ExcludeAssets="contentFiles" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OmenFanPlus.Hp\OmenFanPlus.Hp.csproj" />
		<ProjectReference Include="..\OmenFanPlus.Lib\OmenFanPlus.Lib.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Forms\FormNotify.cs" />
		<Compile Update="Forms\FormHotkey.cs" />
		<Compile Update="Forms\FormPopup.cs" />
		<Compile Update="Properties\Settings.Designer.cs">
		  <DesignTimeSharedInput>True</DesignTimeSharedInput>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>Settings.settings</DependentUpon>
		</Compile>
		<Compile Update="Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Properties\Settings.settings">
	    <Generator>SettingsSingleFileGenerator</Generator>
	    <LastGenOutput>Settings.Designer.cs</LastGenOutput>
	  </None>
	</ItemGroup>

</Project>